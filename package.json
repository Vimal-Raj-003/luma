{
  "name": "luma-falooda",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "flavours:build": "node tools/make-flavour-visuals.mjs",
    "frames:falooda": "node tools/make-falooda-frames.mjs",
    "frame:empty": "node tools/make-empty-frame.mjs",
    "dev": "vite",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "assets": "node tools/make-assets.mjs",
    "layers": "node tools/make-layers.mjs",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=.env.local prisma/seed.mjs",
    "db:studio": "node --env-file=.env.local node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/clerk-react": "^5.61.10",
    "@prisma/client": "^6.19.3",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "ffmpeg-static": "^5.3.0",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.3"
  }
}
